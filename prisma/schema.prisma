generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  name              String
  vertical          String
  clerkUserId       String?        @unique
  status            String         @default("pending")
  twilioNumber      String?        @unique
  phoneVerified     Boolean        @default(false)
  phone             String?
  address           String?
  welcomeMessage    String?
  vacationMode      Boolean        @default(false)
  vacationMessage   String?
  openingHours      Json?
  allergensInfo     String?
  currentPromos     String?
  deliveryEnabled   Boolean        @default(true)
  deliveryFee       Float?         @default(0)
  deliveryMinimum   Float?         @default(0)
  estimatedPrepTime Int?           @default(20)
  paymentMethods    String?        @default("CB, espèces")
  stripeCustomerId     String?     @unique
  stripeSubscriptionId String?     @unique
  subscriptionPlan     String?
  subscriptionStatus   String?     @default("inactive")
  customerEmail        String?
  menuItems         MenuItem[]
  supplements       Supplement[]
  events            Event[]
  conversations     Conversation[]
  staff             Staff[]
  services          Service[]
  appointments      Appointment[]
  auditLogs         AuditLog[]

  @@index([customerEmail])
}

model VerifiedPhone {
  id         String   @id @default(cuid())
  phone      String   @unique
  createdAt  DateTime @default(now())
  businessId String?
  trialUsed  Boolean  @default(false)
}

model MenuItem {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  category     String
  name         String
  description  String?
  price        Float
  available    Boolean  @default(true)

  @@index([businessId])
}

model Supplement {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  price        Float    @default(0)
  available    Boolean  @default(true)

  @@index([businessId])
}

model Event {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  type          String
  status        String   @default("new")
  customerName  String?
  customerPhone String?
  customerEmail String?
  summary       String?
  data          Json?
  externalRef   String?  @unique

  @@index([businessId])
  @@index([type])
}

model Conversation {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  externalId String?   @unique
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  messages   Json?

  @@index([businessId])
}

model Staff {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id])
  name         String
  available    Boolean       @default(true)
  appointments Appointment[]

  @@index([businessId])
}

model Service {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id])
  name         String
  duration     Int
  price        Float         @default(0)
  available    Boolean       @default(true)
  appointments Appointment[]

  @@index([businessId])
}

model Appointment {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])
  serviceId     String?
  service       Service?  @relation(fields: [serviceId], references: [id])
  staffId       String?
  staff         Staff?    @relation(fields: [staffId], references: [id])
  customerName  String
  customerPhone String
  startAt       DateTime
  endAt         DateTime
  status        String    @default("confirmed")
  notes         String?
  externalRef   String?   @unique
  reminderSentAt DateTime?

  @@index([businessId])
  @@index([startAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  actorId     String?
  actorEmail  String?
  action      String
  targetType  String?
  targetId    String?
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  metadata    Json?

  @@index([businessId])
  @@index([action])
  @@index([createdAt])
}
